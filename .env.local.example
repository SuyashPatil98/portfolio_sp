# ============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored. On Vercel, add the same vars in
# Project Settings → Environment Variables (Production + Preview).
# ============================================================================

# ---- Upstash Redis (view counter) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Google Sheets (leads + resume-download log) ----
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the full private_key from the service-account JSON, keeping the
# embedded \n sequences. Wrap the whole thing in double quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---- Resend (email notifications) ----
RESEND_API_KEY=
# Verified sender. For first tests, you can use Resend's onboarding sender:
#   RESEND_FROM="Portfolio <onboarding@resend.dev>"
RESEND_FROM=
# Where to receive notifications (your inbox)
NOTIFY_EMAIL=
